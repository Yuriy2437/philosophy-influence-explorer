# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Philosophy Influence Explorer API

# Legacy GET /api/v1/passages/search is enabled only in development.
# Set APP_ENV=production for a public deployment; the search UI uses POST.
APP_ENV=development

DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# The backend accepts browser requests from this local frontend during development.
# Add deployed frontend addresses as comma-separated values later.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Neo4j / GraphRAG database
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# LLM provider
# Do not place real secrets in .env.example or commit .env to Git.
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Embeddings / semantic retrieval
# Keep the embedding model and vector dimensions consistent with the
# model used to index Passage nodes.
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=4

# -----------------------------------------------------------------------------
# Observability (optional; reserved for later stages)
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=philosophy-influence-explorer
