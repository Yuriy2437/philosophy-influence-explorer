{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PassageRecord",
  "type": "object",
  "required": [
    "id",
    "work_id",
    "source_id",
    "language",
    "text",
    "text_kind",
    "is_verbatim",
    "is_machine_generated",
    "is_editorial",
    "position_label",
    "section_order",
    "citation_label",
    "license_status",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^passage:"
    },
    "work_id": {
      "type": "string",
      "pattern": "^work:"
    },
    "source_id": {
      "type": "string",
      "pattern": "^source:"
    },
    "language": {
      "type": "string",
      "enum": ["ru", "en", "de", "la"]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "text_kind": {
      "type": "string",
      "enum": [
        "primary_quote",
        "editorial_summary",
        "bibliographic_note",
        "translation_reference"
      ]
    },
    "is_verbatim": {
      "type": "boolean"
    },
    "is_machine_generated": {
      "type": "boolean"
    },
    "is_editorial": {
      "type": "boolean"
    },
    "acquisition_method": {
      "type": "string",
      "enum": [
        "not_recorded",
        "direct_transcription",
        "user_excerpt",
        "ocr"
      ],
      "default": "not_recorded"
    },
    "prepared_by": {
      "type": "string",
      "enum": [
        "not_recorded",
        "project_author",
        "ai",
        "other_editor"
      ],
      "default": "not_recorded"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_recorded",
        "not_checked",
        "checked_against_source"
      ],
      "default": "not_recorded"
    },
    "verification_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S",
      "default": null
    },
    "translation_of_passage_id": {
      "type": "string"
    },
    "position_label": {
      "type": "string",
      "minLength": 1
    },
    "section_order": {
      "type": "integer",
      "minimum": 1
    },
    "citation_label": {
      "type": "string",
      "minLength": 1
    },
    "license_status": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "type": "string",
      "enum": ["curated", "reviewed", "candidate", "rejected"]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "verification_status"
        ],
        "properties": {
          "verification_status": {
            "const": "checked_against_source"
          }
        }
      },
      "then": {
        "required": [
          "verification_reference"
        ],
        "properties": {
          "verification_reference": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "text_kind": {
            "const": "primary_quote"
          }
        }
      },
      "then": {
        "properties": {
          "is_verbatim": {
            "const": true
          },
          "is_editorial": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "text_kind": {
            "const": "editorial_summary"
          }
        }
      },
      "then": {
        "properties": {
          "is_verbatim": {
            "const": false
          },
          "is_editorial": {
            "const": true
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
